# --- Servidor ---
NODE_ENV=development
PORT=4000
# Dominio del front (CORS + cookies). En prod: https://tudominio.com
FRONTEND_URL=http://localhost:3000

# --- Base de datos (Railway la provee como DATABASE_URL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celular

# --- Auth ---
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# Admin inicial (se crea al arrancar si no existe ningún admin)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Admin

# --- Storage de imágenes ---
# Cloudinary (recomendado). Si queda vacío, guarda en disco local (solo desarrollo).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
